generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique @map("email") @db.VarChar(255)
  phone        String?  @unique @map("phone") @db.VarChar(20)
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  nickname     String   @map("nickname") @db.VarChar(50)
  avatar       String?  @map("avatar") @db.VarChar(255)
  level        Int      @default(1) @map("level")
  exp          Int      @default(0) @map("exp")
  title        String   @default("厨房小白") @map("title") @db.VarChar(50)
  preferences  Json?    @map("preferences")
  language     String   @default("zh") @map("language") @db.VarChar(10)
  status       Int      @default(1) @map("status")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  progress     UserProgress[]
  badges       UserBadge[]
  favorites    Favorite[]
  posts        CommunityPost[]
  likes        CommunityLike[]
  comments     CommunityComment[]
  notifies     Notification[]
  sessions     CookingSession[]
  searchHistory SearchHistory[]
  sentMessages Message[]     @relation("SentMessages")
  receivedMessages Message[]  @relation("ReceivedMessages")

  @@index([email])
  @@index([phone])
  @@map("users")
}

model UserProgress {
  id          Int       @id @default(autoincrement()) @map("id")
  userId      String    @map("user_id") @db.VarChar(36)
  recipeId    String    @map("recipe_id") @db.VarChar(36)
  completedAt DateTime? @map("completed_at")
  rating      Int?      @map("rating")
  photoUrl    String?   @map("photo_url") @db.VarChar(255)
  notes       String?   @map("notes") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([recipeId])
  @@index([completedAt])
  @@map("user_progress")
}

model UserBadge {
  id         Int       @id @default(autoincrement()) @map("id")
  userId     String    @map("user_id") @db.VarChar(36)
  badgeId    String    @map("badge_id") @db.VarChar(50)
  progress   Int       @default(0) @map("progress")
  unlockedAt DateTime? @map("unlocked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge  Badge  @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}

model Badge {
  id          String    @id @default(uuid())
  name        String    @map("name") @db.VarChar(100)
  nameEn      String    @map("name_en") @db.VarChar(100)
  description String    @map("description") @db.Text
  descriptionEn String  @map("description_en") @db.Text
  icon        String    @map("icon") @db.VarChar(50)
  type        String    @map("type") @db.VarChar(50)
  requirement Int       @map("requirement")
  exp         Int       @default(0) @map("exp")
  createdAt   DateTime  @default(now()) @map("created_at")

  userBadges UserBadge[]

  @@map("badges")
}

model Favorite {
  id        Int      @id @default(autoincrement()) @map("id")
  userId    String   @map("user_id") @db.VarChar(36)
  recipeId  String   @map("recipe_id") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId])
  @@index([recipeId])
  @@map("favorites")
}

model Recipe {
  id          String   @id @default(uuid())
  name        String   @map("name") @db.VarChar(100)
  nameEn      String   @map("name_en") @db.VarChar(100)
  difficulty  String   @map("difficulty") @db.VarChar(20)
  cuisine     String   @map("cuisine") @db.VarChar(50)
  cookTime    Int      @map("cook_time")
  servings    Int      @default(4) @map("servings")
  description String   @map("description") @db.Text
  descriptionEn String  @map("description_en") @db.Text
  images      Json    @map("images")
  videoUrl    String?  @map("video_url") @db.VarChar(255)
  tags        Json    @map("tags")
  viewCount   Int      @default(0) @map("view_count")
  favoriteCount Int    @default(0) @map("favorite_count")
  shareCount  Int      @default(0) @map("share_count")
  status      Int      @default(1) @map("status")
  authorId    String?  @map("author_id") @db.VarChar(36)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ingredients    Ingredient[]
  steps          Step[]
  timers         Timer[]
  userProgress   UserProgress[]
  favorites      Favorite[]
  posts          CommunityPost[]

  @@index([cuisine])
  @@index([difficulty])
  @@index([authorId])
  @@map("recipes")
}

model Ingredient {
  id           Int       @id @default(autoincrement()) @map("id")
  recipeId     String    @map("recipe_id") @db.VarChar(36)
  name         String    @map("name") @db.VarChar(100)
  nameEn       String    @map("name_en") @db.VarChar(100)
  quantity     String    @map("quantity") @db.VarChar(50)
  unit         String    @map("unit") @db.VarChar(20)
  substitutes  Json?     @map("substitutes")
  description  String?   @map("description") @db.Text
  descriptionEn String?  @map("description_en") @db.Text
  nutrition    Json?     @map("nutrition")
  isOptional   Boolean   @default(false) @map("is_optional")
  sortOrder    Int       @default(0) @map("sort_order")

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@map("ingredients")
}

model IngredientEncyclopedia {
  id            String   @id @default(uuid())
  name          String   @map("name") @db.VarChar(100)
  nameEn        String   @map("name_en") @db.VarChar(100)
  nameJa        String?  @map("name_ja") @db.VarChar(100)
  nameKo        String?  @map("name_ko") @db.VarChar(100)
  category      String   @map("category") @db.VarChar(50)
  description   String   @map("description") @db.Text
  descriptionEn String   @map("description_en") @db.Text
  substitutes   Json    @default("[]") @map("substitutes")
  nutrition     Json?   @map("nutrition")
  purchaseTips  String?  @map("purchase_tips") @db.Text
  storageTips   String?  @map("storage_tips") @db.Text
  image         String?  @map("image") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([name])
  @@map("ingredient_encyclopedia")
}

model Step {
  id          Int       @id @default(autoincrement()) @map("id")
  recipeId    String    @map("recipe_id") @db.VarChar(36)
  number      Int       @map("number")
  title       String    @map("title") @db.VarChar(200)
  titleEn     String?    @map("title_en") @db.VarChar(200)
  description String    @map("description") @db.Text
  descriptionEn String? @map("description_en") @db.Text
  image       String?   @map("image") @db.VarChar(255)
  videoUrl    String?   @map("video_url") @db.VarChar(255)
  tips        String?   @map("tips") @db.Text
  tipsEn      String?   @map("tips_en") @db.Text
  duration    Int?      @map("duration")

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@map("steps")
}

model Timer {
  id          Int      @id @default(autoincrement()) @map("id")
  recipeId    String   @map("recipe_id") @db.VarChar(36)
  name        String   @map("name") @db.VarChar(100)
  nameEn      String?  @map("name_en") @db.VarChar(100)
  duration    Int      @map("duration")
  stepNumber  Int      @map("step_number")
  createdAt   DateTime @default(now()) @map("created_at")

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@map("timers")
}

model CookingSession {
  id              Int       @id @default(autoincrement()) @map("id")
  userId          String    @map("user_id") @db.VarChar(36)
  recipeId        String    @map("recipe_id") @db.VarChar(36)
  currentStep     Int       @default(1) @map("current_step")
  completedSteps  Json      @default("[]") @map("completed_steps")
  startedAt       DateTime  @default(now()) @map("started_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([recipeId])
  @@map("cooking_sessions")
}

model CommunityPost {
  id        String   @id @default(uuid())
  userId    String   @map("user_id") @db.VarChar(36)
  recipeId  String?  @map("recipe_id") @db.VarChar(36)
  content   String   @map("content") @db.Text
  images    Json     @default("[]") @map("images")
  likes     Int      @default(0) @map("likes")
  comments  Int      @default(0) @map("comments")
  shares    Int      @default(0) @map("shares")
  status    Int      @default(1) @map("status")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe   Recipe?           @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  likes    CommunityLike[]
  comments CommunityComment[]

  @@index([userId])
  @@index([recipeId])
  @@index([createdAt])
  @@map("community_posts")
}

model CommunityLike {
  id        Int      @id @default(autoincrement()) @map("id")
  userId    String   @map("user_id") @db.VarChar(36)
  postId    String   @map("post_id") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@map("community_likes")
}

model CommunityComment {
  id        String   @id @default(uuid())
  userId    String   @map("user_id") @db.VarChar(36)
  postId    String   @map("post_id") @db.VarChar(36)
  parentId  String?  @map("parent_id") @db.VarChar(36)
  content   String   @map("content") @db.Text
  likes     Int      @default(0) @map("likes")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post  CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent CommunityComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies CommunityComment[] @relation("CommentReplies")

  @@index([userId])
  @@index([postId])
  @@index([parentId])
  @@map("community_comments")
}

model Challenge {
  id          String    @id @default(uuid())
  name        String    @map("name") @db.VarChar(200)
  nameEn      String?   @map("name_en") @db.VarChar(200)
  description String    @map("description") @db.Text
  descriptionEn String  @map("description_en") @db.Text
  hashtag     String    @map("hashtag") @db.VarChar(100)
  image       String?   @map("image") @db.VarChar(255)
  startDate   DateTime  @map("start_date")
  endDate     DateTime  @map("end_date")
  participants Int       @default(0) @map("participants")
  featured    Boolean   @default(false) @map("featured")
  status      Int       @default(1) @map("status")
  createdAt   DateTime  @default(now()) @map("created_at")

  participations ChallengeParticipant[]

  @@index([status])
  @@index([featured])
  @@index([endDate])
  @@map("challenges")
}

model ChallengeParticipant {
  id          Int       @id @default(autoincrement()) @map("id")
  challengeId String    @map("challenge_id") @db.VarChar(36)
  userId      String    @map("user_id") @db.VarChar(36)
  postId      String?   @map("post_id") @db.VarChar(36)
  status      Int       @default(1) @map("status")
  joinedAt    DateTime  @default(now()) @map("joined_at")

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([challengeId])
  @@index([userId])
  @@map("challenge_participants")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id") @db.VarChar(36)
  type      String   @map("type") @db.VarChar(50)
  title     String   @map("title") @db.VarChar(200)
  content   String   @map("content") @db.Text
  data      Json?    @map("data")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model SearchHistory {
  id        Int      @id @default(autoincrement()) @map("id")
  userId    String   @map("user_id") @db.VarChar(36)
  keyword   String   @map("keyword") @db.VarChar(200)
  type      String   @default("recipe") @map("type") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("search_history")
}

model Message {
  id         String   @id @default(uuid())
  senderId   String   @map("sender_id") @db.VarChar(36)
  receiverId String   @map("receiver_id") @db.VarChar(36)
  content    String   @map("content") @db.Text
  type       String   @default("text") @map("type") @db.VarChar(20)
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@map("messages")
}
