.page {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding-bottom: 140rpx;
}

.hero-section {
  position: relative;
  height: 300rpx;
}

.recipe-image {
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
}

.recipe-name {
  color: #FFF;
  font-size: 36rpx;
  font-weight: bold;
}

.progress-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  background: #FFF;
}

.progress-track {
  flex: 1;
  height: 12rpx;
  background: #E0E0E0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF8C42, #FF6B35);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.progress-text {
  font-size: 28rpx;
  color: #FF8C42;
  font-weight: 600;
  min-width: 80rpx;
  text-align: right;
}

.nav-btns {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 32rpx;
  background: #FFF;
}

.nav-btn {
  padding: 12rpx 24rpx;
  background: #F5F5F5;
  border-radius: 50rpx;
  font-size: 26rpx;
  color: #666;
  border: none;
}

.nav-btn[disabled] {
  opacity: 0.5;
}

.current-step-indicator {
  padding: 12rpx 32rpx;
  background: #FF8C42;
  color: #FFF;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.step-card {
  margin: 24rpx 32rpx;
  padding: 32rpx;
  background: #FFF;
  border-radius: 16rpx;
}

.step-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.step-number-lg {
  width: 64rpx;
  height: 64rpx;
  background: #FF8C42;
  color: #FFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
}

.step-title-area {
  flex: 1;
}

.step-title {
  display: block;
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 4rpx;
}

.step-subtitle {
  display: block;
  font-size: 26rpx;
  color: #999;
}

.step-description {
  display: block;
  font-size: 30rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 24rpx;
}

.step-image {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
}

.timers-area {
  margin: 0 32rpx 24rpx;
  padding: 24rpx;
  background: #FFF;
  border-radius: 16rpx;
}

.timers-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.timer-cards {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.timer-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #FFF5EE;
  border-radius: 12rpx;
}

.timer-name {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.timer-time {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF8C42;
  margin: 0 24rpx;
  font-variant-numeric: tabular-nums;
}

.timer-btn {
  padding: 8rpx 20rpx;
  border-radius: 50rpx;
  font-size: 24rpx;
  border: none;
}

.timer-btn.pause {
  background: #FF8C42;
  color: #FFF;
}

.timer-btn.resume {
  background: #4CAF50;
  color: #FFF;
}

.steps-overview {
  margin: 0 32rpx 24rpx;
  padding: 24rpx;
  background: #FFF;
  border-radius: 16rpx;
}

.overview-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.steps-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.step-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #F9F9F9;
}

.step-item.active {
  background: #FFF3E0;
}

.step-item.completed {
  background: #E8F5E9;
}

.step-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #E0E0E0;
  color: #666;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
}

.step-item.active .step-dot {
  background: #FF8C42;
  color: #FFF;
}

.step-item.completed .step-dot {
  background: #4CAF50;
  color: #FFF;
}

.step-item-title {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.step-item.completed .step-item-title {
  color: #666;
  text-decoration: line-through;
}

.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: #FFF;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
}

.btn-complete {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #FF8C42, #FF6B35);
  color: #FFF;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-complete::after {
  border: none;
}

.loading {
  text-align: center;
  padding: 100rpx;
  color: #999;
}
