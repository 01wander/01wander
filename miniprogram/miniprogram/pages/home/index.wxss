.page {
  min-height: 100vh;
  background-color: #F5F5F5;
}

.hero {
  position: relative;
  height: 400rpx;
}

.hero-bg {
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.5), rgba(0,0,0,0.7));
}

.hero-content {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 60rpx 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.hero-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 16rpx;
}

.hero-subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  margin-bottom: 32rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.95);
  border-radius: 50rpx;
  padding: 20rpx 32rpx;
}

.search-placeholder {
  color: #999;
  margin-left: 16rpx;
  font-size: 28rpx;
}

.section {
  padding: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 28rpx;
  color: #FF8C42;
}

.cuisine-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

.cuisine-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.cuisine-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.cuisine-name {
  font-size: 26rpx;
  color: #666;
}

.recipe-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.recipe-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.recipe-image {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.recipe-info {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.recipe-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.recipe-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.recipe-difficulty {
  font-size: 24rpx;
  font-weight: 500;
}

.recipe-time {
  font-size: 24rpx;
  color: #999;
}

.stats-section {
  padding: 0 32rpx 32rpx;
}

.stats-card {
  display: flex;
  justify-content: space-around;
  background: linear-gradient(135deg, #FF8C42, #FF6B35);
  border-radius: 16rpx;
  padding: 32rpx;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.stats-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
  margin-top: 8rpx;
}

.loading {
  text-align: center;
  padding: 32rpx;
  color: #999;
}
