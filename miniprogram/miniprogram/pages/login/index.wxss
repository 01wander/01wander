.page {
  min-height: 100vh;
  background-color: #FFFFFF;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  padding-top: 60rpx;
}

.back-btn {
  font-size: 40rpx;
  color: #333;
  padding: 8rpx;
}

.header-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.placeholder {
  width: 56rpx;
}

.logo-section {
  text-align: center;
  padding: 80rpx 0 60rpx;
}

.logo {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.app-name {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #FF8C42;
  margin-bottom: 12rpx;
}

.app-slogan {
  display: block;
  font-size: 28rpx;
  color: #999;
}

.form-section {
  padding: 0 48rpx;
}

.input-group {
  margin-bottom: 32rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.input-field {
  width: 100%;
  height: 88rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.input-field:focus {
  background: #FFF;
  border: 2rpx solid #FF8C42;
}

.btn-submit {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FF8C42, #FF6B35);
  color: #FFF;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-top: 16rpx;
}

.btn-submit::after {
  border: none;
}

.btn-submit[loading] {
  opacity: 0.8;
}

.switch-mode {
  text-align: center;
  margin-top: 32rpx;
}

.switch-text {
  font-size: 28rpx;
  color: #999;
}

.switch-btn {
  font-size: 28rpx;
  color: #FF8C42;
  margin-left: 8rpx;
  font-weight: 500;
}

.divider {
  display: flex;
  align-items: center;
  margin: 48rpx 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #E0E0E0;
}

.divider-text {
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #999;
}

.btn-wechat {
  width: 100%;
  height: 96rpx;
  background: #07C160;
  color: #FFF;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-wechat::after {
  border: none;
}

.wechat-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}
