.page {
  min-height: 100vh;
  background-color: #F5F5F5;
}

.filter-section {
  background: #FFF;
  padding: 16rpx 0;
  position: sticky;
  top: 0;
  z-index: 100;
}

.filter-scroll {
  white-space: nowrap;
}

.filter-list {
  display: inline-flex;
  padding: 0 16rpx;
}

.filter-item {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin: 0 8rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  color: #666;
  background: #F5F5F5;
  white-space: nowrap;
}

.filter-item.active {
  background: #FF8C42;
  color: #FFF;
}

.recipe-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  padding: 24rpx;
}

.recipe-card {
  background: #FFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.recipe-image {
  width: 100%;
  height: 240rpx;
}

.recipe-info {
  padding: 20rpx;
}

.recipe-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recipe-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.recipe-difficulty {
  font-size: 22rpx;
  font-weight: 500;
}

.recipe-time {
  font-size: 22rpx;
  color: #999;
}

.loading, .empty, .loading-full {
  text-align: center;
  padding: 32rpx;
  color: #999;
  font-size: 28rpx;
}
