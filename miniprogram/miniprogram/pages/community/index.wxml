<view class="page">
  <view class="post-list">
    <view class="post-card" wx:for="{{posts}}" wx:key="id">
      <view class="post-header" bindtap="goToProfile" data-userid="{{item.userId}}">
        <image class="user-avatar" src="{{item.userAvatar}}" mode="aspectFill" />
        <view class="user-info">
          <text class="user-name">{{item.userName}}</text>
          <text class="post-time">{{formatTime(item.createdAt)}}</text>
        </view>
      </view>

      <view class="post-content">
        <text class="post-text">{{item.content}}</text>

        <view wx:if="{{item.recipeId && item.recipeName}}" class="recipe-tag" bindtap="goToRecipe" data-recipeid="{{item.recipeId}}">
          <text class="iconfont icon-recipe"></text>
          <text>{{item.recipeName}}</text>
        </view>
      </view>

      <view class="post-images" wx:if="{{item.images.length > 0}}">
        <image
          wx:for="{{item.images}}"
          wx:for-item="img"
          wx:key="*this"
          class="post-image {{item.images.length === 1 ? 'single' : ''}}"
          src="{{img}}"
          mode="aspectFill"
          bindtap="previewImages"
          data-urls="{{item.images}}"
          data-current="{{img}}"
        />
      </view>

      <view class="post-actions">
        <view
          class="action-item {{item.liked ? 'liked' : ''}}"
          bindtap="likePost"
          data-id="{{item.id}}"
        >
          <text class="action-icon">{{item.liked ? '❤️' : '🤍'}}</text>
          <text class="action-count">{{item.likes}}</text>
        </view>
        <view class="action-item">
          <text class="action-icon">💬</text>
          <text class="action-count">{{item.comments}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="loading" wx:if="{{loading && posts.length > 0}}">
    <text>加载更多...</text>
  </view>

  <view class="empty" wx:if="{{!loading && posts.length === 0}}">
    <text>暂无帖子，快来发布第一篇吧</text>
  </view>

  <view class="fab" bindtap="publishPost">
    <text class="fab-icon">+</text>
  </view>
</view>
