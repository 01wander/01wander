.page {
  padding-bottom: 140rpx;
  background-color: #F5F5F5;
}

.hero-image {
  position: relative;
  height: 400rpx;
}

.hero-image image {
  width: 100%;
  height: 100%;
}

.difficulty-badge {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 50rpx;
  color: #FFF;
  font-size: 24rpx;
  font-weight: 600;
}

.content {
  padding: 32rpx;
}

.title-section {
  margin-bottom: 24rpx;
}

.recipe-name {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.recipe-name-en {
  display: block;
  font-size: 28rpx;
  color: #999;
}

.meta-row {
  display: flex;
  justify-content: space-around;
  background: #FFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.meta-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.meta-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.meta-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.meta-label {
  font-size: 24rpx;
  color: #999;
}

.description {
  background: #FFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.section {
  background: #FFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.servings-adj {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.servings-label {
  font-size: 28rpx;
  color: #666;
}

.servings-btns {
  display: flex;
  gap: 16rpx;
}

.servings-btn {
  width: 56rpx;
  height: 56rpx;
  background: #FF8C42;
  color: #FFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
}

.ingredient-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ingredient-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.ingredient-name {
  font-size: 28rpx;
  color: #333;
}

.ingredient-qty {
  font-size: 28rpx;
  color: #FF8C42;
  font-weight: 500;
}

.step-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.step-item {
  display: flex;
  gap: 20rpx;
}

.step-number {
  width: 56rpx;
  height: 56rpx;
  background: #FF8C42;
  color: #FFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.step-content {
  flex: 1;
}

.step-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.step-desc {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.step-image {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  margin-top: 16rpx;
}

.timers-section {
  background: #FFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.timer-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.timer-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #FFF5EE;
  padding: 16rpx 24rpx;
  border-radius: 50rpx;
}

.timer-name {
  font-size: 26rpx;
  color: #333;
}

.timer-duration {
  font-size: 26rpx;
  color: #FF8C42;
  font-weight: 600;
}

.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: #FFF;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
}

.btn-start {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #FF8C42, #FF6B35);
  color: #FFF;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-start::after {
  border: none;
}

.loading {
  text-align: center;
  padding: 100rpx;
  color: #999;
}
