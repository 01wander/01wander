<view class="page">
  <view class="profile-header" wx:if="{{user}}">
    <image class="avatar" src="{{user.avatar || '/assets/images/default-avatar.png'}}" mode="aspectFill" />
    <view class="user-info">
      <text class="nickname">{{user.nickname}}</text>
      <view class="user-meta">
        <text class="level">Lv.{{user.level}}</text>
        <text class="title">{{user.title}}</text>
      </view>
      <view class="exp-bar">
        <view class="exp-fill" style="width: {{(user.exp % 100)}}%"></view>
        <text class="exp-text">{{user.exp}} / 100</text>
      </view>
    </view>
  </view>

  <view class="login-prompt" wx:if="{{!user && !loading}}">
    <text class="prompt-text">登录后查看个人信息</text>
    <button class="btn-login" bindtap="goToLogin">立即登录</button>
  </view>

  <view class="menu-section">
    <view class="menu-item" bindtap="goToFavorites">
      <text class="menu-icon">❤️</text>
      <text class="menu-label">我的收藏</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToSettings">
      <text class="menu-icon">⚙️</text>
      <text class="menu-label">设置</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="logout" wx:if="{{user}}">
      <text class="menu-icon">🚪</text>
      <text class="menu-label">退出登录</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
