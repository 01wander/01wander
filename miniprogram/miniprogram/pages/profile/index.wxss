.page {
  min-height: 100vh;
  background-color: #F5F5F5;
}

.profile-header {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FF8C42, #FF6B35);
  padding: 48rpx 32rpx;
  gap: 32rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #FFF;
}

.user-info {
  flex: 1;
}

.nickname {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #FFF;
  margin-bottom: 8rpx;
}

.user-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.level {
  padding: 4rpx 16rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50rpx;
  font-size: 22rpx;
  color: #FFF;
}

.title {
  padding: 4rpx 16rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50rpx;
  font-size: 22rpx;
  color: #FFF;
}

.exp-bar {
  position: relative;
  height: 16rpx;
  background: rgba(0,0,0,0.2);
  border-radius: 8rpx;
  overflow: hidden;
}

.exp-fill {
  height: 100%;
  background: #FFF;
  border-radius: 8rpx;
  transition: width 0.3s;
}

.exp-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 20rpx;
  color: #FFF;
  font-weight: 600;
}

.login-prompt {
  background: linear-gradient(135deg, #FF8C42, #FF6B35);
  padding: 64rpx 32rpx;
  text-align: center;
}

.prompt-text {
  display: block;
  font-size: 32rpx;
  color: #FFF;
  margin-bottom: 32rpx;
}

.btn-login {
  padding: 20rpx 64rpx;
  background: #FFF;
  color: #FF8C42;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.menu-section {
  margin: 24rpx;
  background: #FFF;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 28rpx;
  color: #CCC;
}

.loading {
  text-align: center;
  padding: 100rpx;
  color: #999;
}
