.page {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding: 24rpx;
}

.stats-card {
  background: linear-gradient(135deg, #FF8C42, #FF6B35);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.stats-header {
  margin-bottom: 24rpx;
}

.stats-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #FFF;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #FFF;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
  margin-top: 8rpx;
}

.section {
  background: #FFF;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-count {
  font-size: 26rpx;
  color: #999;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background: #F9F9F9;
  border-radius: 12rpx;
}

.record-info {
  flex: 1;
}

.record-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.record-date {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.record-rating {
  margin-right: 16rpx;
}

.stars {
  font-size: 24rpx;
}

.record-photo {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
}

.empty {
  text-align: center;
  padding: 48rpx 0;
  color: #999;
  font-size: 28rpx;
}

.btn-start {
  margin-top: 24rpx;
  padding: 16rpx 48rpx;
  background: linear-gradient(135deg, #FF8C42, #FF6B35);
  color: #FFF;
  border-radius: 50rpx;
  font-size: 28rpx;
  border: none;
}

.loading {
  text-align: center;
  padding: 100rpx;
  color: #999;
}
